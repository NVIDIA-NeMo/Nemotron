# Copy this file to .env for a live run. Never commit the populated .env file.
# Replay mode (the notebook's default) loads the included live-run recording and needs none of these.

# Official NVIDIA Build endpoint: generate a key at https://build.nvidia.com/settings.
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_API_KEY=

# Optional: path to Chrome or Chromium, used to render dashboard tabs and documents in live runs.
# CHROME_PATH=/usr/bin/chromium
