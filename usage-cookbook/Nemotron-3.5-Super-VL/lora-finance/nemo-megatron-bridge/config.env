# The one file to edit. Every step reads it, in the notebook and on Slurm.

# NeMo container every step runs in
CONTAINER_IMAGE=nvcr.io/nvidian/nemo:26.10.rc4
# Model to fine-tune
HF_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-BF16

# All outputs (~800 GB): model/, base/, dataprep/, trained/, hf/. Absolute path; on Slurm, one every node sees
WORKSPACE=/path/to/workspace
# Downloaded model (250 GB); keep inside WORKSPACE, the only path mounted into the container
MODEL_DIR=$WORKSPACE/model
# Hugging Face cache; keep inside WORKSPACE too
HF_HOME=$WORKSPACE/hf

# Training layout. Total GPUs (GPUS_PER_NODE x nodes) must be divisible by both TP x PP and EP x PP.
# Tested layouts (TP/PP/EP): 8 GPUs 2/1/8 or 4/1/8 (80 GB GPUs), 16 GPUs on 2 nodes 4/2/8, 4 GPUs 4/1/4.
# GPUs on each node; training starts one process per GPU
GPUS_PER_NODE=8
# Tensor parallel: splits each layer across this many GPUs; at most GPUS_PER_NODE; raise it if out of memory
TRAIN_TP=2
# Pipeline parallel: splits the layers into this many stages; 1 on one node, 2 on two nodes
TRAIN_PP=1
# Expert parallel: spreads the MoE experts across this many GPUs; usually total GPUs / PP
TRAIN_EP=8

# Passes over the training data (1,389 steps each)
EPOCHS=1
# Stop early, e.g. 3 for a smoke test; empty trains all EPOCHS
MAX_STEPS=
# Run name: the adapter goes to $WORKSPACE/trained/<name>; use a new one per run
EXPERIMENT_NAME=finance-lora
