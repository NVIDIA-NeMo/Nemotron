+
+
+def _extract_json_object(parser: LLMResponseParser, response: str) -> dict:
+    structured_blocks = parser.parse(response).filter([StructuredDataBlock]).parsed
+    if structured_blocks:
+        return structured_blocks.pop().obj
+
+    try:
+        obj = json.loads(response, parse_constant=_reject_nonstandard_json_constant)
+    except (json.JSONDecodeError, ValueError):
+        obj = None
+
+    if not isinstance(obj, dict):
+        raise ParserException(
+            "No parsable JSON object in the response or within a ```json markdown fence.",
+            source=response,
+        )
+    return obj
+
